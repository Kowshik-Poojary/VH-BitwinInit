# Copy this file to `.env` and fill in real values before `docker compose up`.
# `.env` is git-ignored; `.env.example` is not.

# --- Database -------------------------------------------------------------

# MongoDB connection string. Uses MongoDB Atlas (free tier is fine).
# Format:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Atlas setup:
#   1. Create a free cluster at https://cloud.mongodb.com
#   2. Database Access -> add a user with read/write on the target DB.
#   3. Network Access -> allow the IP of wherever this container runs
#      (0.0.0.0/0 is easiest for a demo, tighten for real deployments).
#   4. Clusters -> Connect -> "Connect your application" -> copy the string.
MONGODB_URI=

# --- Backend secrets ------------------------------------------------------

# Long random string used to sign JWTs. Generate with:
#   openssl rand -hex 32
# Backend refuses to start without this (unless LEAKGUARD_DEV=1).
JWT_SECRET=

# First-run admin bootstrap. Only used on the very first startup, when the
# `accounts` collection has no admin yet. After that the admin is persisted
# in MongoDB and these can be removed / rotated. Do NOT reuse a personal
# password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Comma-separated list of frontend origins allowed to call the backend.
# Match this to wherever the frontend container is reachable from a browser.
# Example for the default compose setup:
CORS_ORIGINS=http://localhost:8080

# Shared secret the GitHub Action sends as X-LeakGuard-Token when reporting
# a run to /api/reports/action-run. Generate with `openssl rand -hex 32`
# and add the same value as a GitHub Actions secret (e.g. LEAKGUARD_TOKEN)
# in each repository whose runs should show up in this dashboard.
LEAKGUARD_INGEST_TOKEN=

# --- Frontend -------------------------------------------------------------

# Public URL of the backend as reached from the user's browser (NOT from
# inside the docker network). For a local `docker compose up` this is the
# host-side port mapping of the backend service.
API_BASE=http://localhost:8000
